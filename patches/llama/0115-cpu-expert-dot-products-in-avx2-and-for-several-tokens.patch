+        const __m256i scales  = MM256_SET_M128I(sc128, sc128);                                                    \
+        const float xd = GGML_CPU_FP16_TO_FP32(x[i].d), xdmin = GGML_CPU_FP16_TO_FP32(x[i].dmin);                 \
