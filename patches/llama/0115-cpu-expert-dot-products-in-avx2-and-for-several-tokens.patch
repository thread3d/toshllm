+    const __m256i mone = _mm256_set1_epi8(1);                                                                     \
+    const __m128i m32 = _mm_set1_epi8(32);                                                                        \
+    __m256 acc[NC];                                                                                               \
+    for (int c = 0; c < NC; ++c) acc[c] = _mm256_setzero_ps();                                                    \
+    uint32_t aux[3];                                                                                              \
+    for (int i = 0; i < nb; ++i) {                                                                                \
+        const float xd = GGML_CPU_FP16_TO_FP32(x[i].d);                                                           \
