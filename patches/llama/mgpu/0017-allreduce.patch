+            /*.ne01 =*/ (int32_t) acc->ne[1],
+            /*.ne02 =*/ (int32_t) acc->ne[2],
+            /*.ne03 =*/ (int32_t) acc->ne[3],
+            /*.nb00 =*/ acc->nb[0],
+            /*.nb01 =*/ acc->nb[1],
+            /*.nb02 =*/ acc->nb[2],
+            /*.nb03 =*/ acc->nb[3],
+            /*.ne10 =*/ (int32_t) acc->ne[0],
+            /*.ne11 =*/ (int32_t) acc->ne[1],
+            /*.ne12 =*/ (int32_t) acc->ne[2],
+            /*.ne13 =*/ (int32_t) acc->ne[3],
