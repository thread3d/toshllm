+    CFNumberRef u = (CFNumberRef) CFDictionaryGetValue(ps, CFSTR("inUseVidMemoryBytes"));
+    const bool ok = f != NULL && u != NULL &&
+        CFNumberGetValue(f, kCFNumberSInt64Type, vfree) && CFNumberGetValue(u, kCFNumberSInt64Type, vused);
+    CFRelease(ps);
+    return ok;
+}
