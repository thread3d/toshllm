+    GGML_ASSERT(il >= 0 && il < TOSH_DMOE_MAX_LAYERS);
+    GGML_ASSERT(n_tokens <= TOSH_DMOE_WIDE_MAX_TOKENS && n_embd % 4 == 0 && n_expert <= 1024);
