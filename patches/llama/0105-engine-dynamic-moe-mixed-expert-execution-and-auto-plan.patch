+        GGML_ASSERT(dev->dmoe_stage != nil);
+        memset([dev->dmoe_stage contents], 0, size);
+        tosh_dmoe_set_stage([dev->dmoe_stage contents], layer_stride);
+    }
+    [dev->dmoe_lock unlock];
+    struct ggml_metal_buffer_id res = { dev->dmoe_stage, 0 };
+    return res;
+}
