+
+    // copies a layer's routing to the host for the residency policy, nothing else
+    GGML_API struct ggml_tensor * ggml_tosh_dmoe_observe(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * ids,        // [n_expert_used, n_tokens] i32
