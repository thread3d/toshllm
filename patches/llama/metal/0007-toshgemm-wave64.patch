+                        }
+                        for (short cc = 0; cc < NCC; cc++) {
+                            bv[cc] = *(threadgroup const vec<S1,2> *)(lsmb + 64*cc + 8*lc + k);
+                        }
+                        for (short rr = 0; rr < NLR; rr++) {
+                            for (short cc = 0; cc < NCC; cc++) {
