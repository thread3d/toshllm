+        + args.nb12*i12
+        + args.nb11*i11
+        + args.nb10*iy);
+
+    device const T1 * yb = (device const T1 *)(src1
+        + args.nb13*i13
+        + args.nb12*i12b
+        + args.nb11*i11b
+        + args.nb10*iy);
