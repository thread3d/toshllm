+static struct ggml_metal_xdev_link * ggml_metal_xdev_link_get(
+        ggml_metal_t ctx_src, ggml_metal_t ctx_dst) {
+    struct ggml_metal_xdev_link * link = NULL;
+    for (int i = 0; i < ctx_dst->n_xlinks; i++) {
