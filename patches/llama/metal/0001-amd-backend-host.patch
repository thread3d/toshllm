+static struct {
+    _Atomic int      state; // 0 unknown, 1 off, 2 on
+    _Atomic uint64_t calls  [TOSH_PROF_N];
+    _Atomic uint64_t bytes  [TOSH_PROF_N];
+    _Atomic uint64_t wait_ns[TOSH_PROF_N];
+    _Atomic uint64_t t_last;
