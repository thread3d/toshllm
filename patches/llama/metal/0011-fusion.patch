+                bi = i;
+            }
+        }
+        rv[tiitg] = bv;
+        si[tiitg] = bi;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (uint s = ntg/2; s > 0; s >>= 1) {
+            if (tiitg < s) {
+                const float ov = rv[tiitg + s];
+                const int   oi = si[tiitg + s];
