+        constant ggml_metal_kargs_tosh_topk_moe & args,
+        device const char * src_logits,
+        device const char * src_bias,
+        device       char * dst_weights,
+        device       char * dst_ids,
+        threadgroup float * sf [[threadgroup(0)]],
+        threadgroup int   * si [[threadgroup(1)]],
