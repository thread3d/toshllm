+        uint  tiitg[[thread_index_in_threadgroup]],
+        uint3 ntgg [[threads_per_threadgroup]]) {
+    const uint ntg = ntgg.x;
+    const int row = tgpig.x;
+    if (row >= args.nrows) {
+        return;
+    }
