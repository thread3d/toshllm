+            wt[i] = v;
+        }
+        sel[i] = args.has_bias ? v + bias[i] : v;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (int k = 0; k < nu; ++k) {
+        float bv = -INFINITY;
+        int   bi = ne;
+        for (int i = tiitg; i < ne; i += ntg) {
+            const float v = sel[i];
