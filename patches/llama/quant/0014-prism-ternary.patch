+// the l2 norm of q or k, scale(rms_norm(x, eps/n), 1/sqrt(n)), done by the kernel
+struct ggml_metal_gdn_l2 {
+    const ggml_tensor * scale = nullptr, * norm = nullptr, * x = nullptr;
+    float eps = 0.0f;
+};
