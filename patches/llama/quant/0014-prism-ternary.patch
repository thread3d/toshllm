+        reg[v] = shmem[tiisg + NW*(v % NSG) + NT*(v/NSG + (NV/NSG)*sgitg)];
+    }
+    for (short s = 1; s < NSG; s *= 2) {
+        FOR_UNROLL (short v = 0; v < NV; v++) {
+            if ((v & s) == 0) {
+                const float x = reg[v];
+                const float y = reg[v + s];
+                reg[v]     = x + y;
+                reg[v + s] = x - y;
+            }
+        }
+    }
+
