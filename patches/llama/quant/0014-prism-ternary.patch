+    FOR_UNROLL (short s = 0; s < 8; ++s) {
+        const half2 h = (as_type<half2>(((w >> (2*s)) & 0x00030003u) | 0x64006400u) - half2(1025.0h))*d;
+        r[s/4][s%4]     = h[0];
+        r[s/4 + 2][s%4] = h[1];
+    }
+    reg = (type4x4) r;
