+static bool ggml_metal_gdn_single_use(const ggml_cgraph * gf, const ggml_tensor * t) {
+    return t && ggml_metal_use_count(gf, t) == 1 && !(t->flags & GGML_TENSOR_FLAG_OUTPUT) &&
