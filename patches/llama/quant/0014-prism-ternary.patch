+    const int64_t n_state  = ggml_nelements(gdn->src[5]);
+    for (int i = idx + 1; i < std::min(ctx->n_nodes(), idx + 16); ++i) {
+        const ggml_tensor * c = ctx->node(i);
+        if (c->op != GGML_OP_CPY) {
